# libFuzzer dictionary of Quilibrium canonical 4-byte big-endian type prefixes.
# Feed with `-dict=fuzz/canonical_types.dict` so the fuzzer plants valid magic
# prefixes instead of brute-forcing 32-bit tokens (which it essentially can't).
frame_global      = "\x00\x00\x03\x0e"
frame_header      = "\x00\x00\x03\x09"
frame_header2     = "\x00\x00\x03\x0a"
msg_bundle        = "\x00\x00\x03\x12"
msg_request       = "\x00\x00\x03\x11"
multiproof        = "\x00\x00\x03\x13"
path              = "\x00\x00\x03\x14"
traversal_proof   = "\x00\x00\x03\x16"
quorum_cert       = "\x00\x00\x03\x0d"
timeout_cert      = "\x00\x00\x03\x1d"
timeout_state     = "\x00\x00\x03\x1c"
prover_join       = "\x00\x00\x03\x01"
prover_leave      = "\x00\x00\x03\x02"
prover_pause      = "\x00\x00\x03\x03"
prover_resume     = "\x00\x00\x03\x04"
prover_confirm    = "\x00\x00\x03\x05"
prover_reject     = "\x00\x00\x03\x06"
prover_kick       = "\x00\x00\x03\x07"
prover_update     = "\x00\x00\x03\x08"
seniority_merge   = "\x00\x00\x03\x10"
prover_sen_merge  = "\x00\x00\x03\x1a"
shard_split       = "\x00\x00\x03\x1e"
shard_merge       = "\x00\x00\x03\x1f"
alt_shard_update  = "\x00\x00\x03\x19"
app_shard_prop    = "\x00\x00\x03\x18"
global_proposal   = "\x00\x00\x03\x17"
leaf_root_reg     = "\x00\x00\x03\x20"
execution_dag     = "\x00\x00\x06\x0a"
execute_operation = "\x00\x00\x06\x08"
execution_node    = "\x00\x00\x06\x09"
execution_stage   = "\x00\x00\x06\x0b"
code_execute      = "\x00\x00\x06\x0c"
compute_deploy    = "\x00\x00\x06\x01"
