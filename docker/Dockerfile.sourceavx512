# syntax=docker.io/docker/dockerfile:1.7-labs
# Build on ubuntu:22.04 (glibc 2.35) so the dynamically-linked binaries
# run on Ubuntu 22.04 hosts as well as newer releases — glibc symbol
# versions are stamped from the build environment, and binaries linked
# on 24.04 (glibc 2.39) refuse to load on 22.04. The runtime image stage
# below stays on 24.04; the binary is forward-compatible.
#
# Build from the repository root, e.g.:
#   docker build -f docker/Dockerfile.sourceavx512 --target=node --output node/build/amd64_avx512_linux .
FROM --platform=${TARGETPLATFORM} ubuntu:22.04 AS base-avx512

ENV PATH="${PATH}:/root/.cargo/bin/"

ARG TARGETOS
ARG TARGETARCH

# Install basics. Note: no apt protobuf-compiler (22.04 ships protoc
# 3.12, which predates the proto3 `optional` support prost-build
# needs — upstream protoc installed below).
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    cmake \
    libgmp-dev \
    libmpfr-dev \
    libmpfr6 \
    wget \
    m4 \
    pkg-config \
    gcc \
    g++ \
    make \
    autoconf \
    automake \
    libtool \
    libssl-dev \
    clang \
    unzip \
    ca-certificates \
    python3 \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

ARG PROTOC_VERSION=25.1
RUN ARCH=$(dpkg --print-architecture) && \
    case ${ARCH} in \
    amd64) PROTOC_ARCH=x86_64 ;; \
    arm64) PROTOC_ARCH=aarch_64 ;; \
    *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/protoc.zip \
        https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip && \
    unzip -o /tmp/protoc.zip -d /usr/local bin/protoc 'include/*' && \
    rm /tmp/protoc.zip

# Build GMP from source as a static, PIC archive before FLINT. FLINT's
# static code references internal `__gmpn_*` symbols that aren't
# guaranteed to be exported by every host's libgmp.so, so bundle a known
# GMP into the binary instead of depending on the distro one at runtime.
ARG GMP_VERSION=6.3.0
# Force cross-compile mode (--build != --host) so configure does not
# attempt to RUN test binaries. The build container's CPU may lack
# AVX-512, but the produced object code targets skylake-avx512 and
# will only ever run on hosts that have it. Without cross-compile
# mode, GMP's ABI probe SIGILLs on the build machine and configure
# aborts with "program does not run".
RUN wget https://gmplib.org/download/gmp/gmp-${GMP_VERSION}.tar.xz && \
    tar -xf gmp-${GMP_VERSION}.tar.xz && \
    cd gmp-${GMP_VERSION} && \
    ./configure \
        --prefix=/usr/local \
        --enable-static \
        --disable-shared \
        --with-pic \
        --build="$(./config.guess)" \
        --host=skylake_avx512-pc-linux-gnu \
        CFLAGS="-march=skylake-avx512 -mtune=skylake-avx512 -O3" && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf gmp-${GMP_VERSION} gmp-${GMP_VERSION}.tar.xz

# Build FLINT from source with AVX-512. Links against the static GMP we
# just installed via --with-gmp=/usr/local. -fPIC lets the static archive
# slot into the Rust-compiled PIE binary. Same cross-compile reasoning
# as GMP — configure must not try to run AVX-512 probes on the build CPU.
RUN git clone https://github.com/flintlib/flint.git && \
    cd flint && \
    git checkout flint-3.0 && \
    ./bootstrap.sh && \
    ./configure \
        --prefix=/usr/local \
        --with-gmp=/usr/local \
        --with-mpfr=/usr/local \
	      --enable-avx512 \
        --enable-static \
        --disable-shared \
        --build="$(./build-aux/config.guess 2>/dev/null || gcc -dumpmachine)" \
        --host=x86_64-pc-linux-gnu \
        CFLAGS="-march=skylake-avx512 -mtune=skylake-avx512 -O3 -fPIC" && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf flint

COPY docker/rustup-init.sh /opt/rustup-init.sh

RUN /opt/rustup-init.sh -y --profile minimal

# -----------------------------------------------------------------------------
# Stage: gen-avx512
# Purpose: Build the AVX-512 EMP toolkit libraries that the Rust crypto crates
#          link against. Only Rust/EMP sources are copied here so that source
#          changes elsewhere don't bust the cache.
# -----------------------------------------------------------------------------
FROM base-avx512 AS gen-avx512

ENV QUILIBRIUM_SIGNATURE_CHECK=false

WORKDIR /opt/ceremonyclient

# Rust workspace files (rarely change)
COPY Cargo.toml Cargo.lock ./

# Rust crate sources
COPY crates crates

# EMP toolkit sources
COPY install-emp.sh .
COPY emp-tool emp-tool
COPY emp-ot emp-ot

RUN bash install-emp.sh

ENV CFLAGS="-march=skylake-avx512 -mtune=skylake-avx512"
RUN cd emp-tool && sed -i 's/add_library(${NAME} SHARED ${sources})/add_library(${NAME} STATIC ${sources})/g' CMakeLists.txt && mkdir build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && cd .. && make && make install && cd ..

RUN cd emp-ot && mkdir build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && cd .. && make && make install && cd ..

# -----------------------------------------------------------------------------
# Stage: build-avx512
# Purpose: Add full source tree for the Rust builds. Changes here only bust
#          build cache, not the expensive gen stage above.
# -----------------------------------------------------------------------------
FROM gen-avx512 AS build-avx512

WORKDIR /opt/ceremonyclient

# Copy full source tree for the Rust builds. node/ is brought in by the stages
# that need it, so changes there only bust those stages.
COPY --exclude=node . .

FROM build-avx512 AS build-node-avx512

# Build and install the node. It also runs itself as its confidential token
# proof verifier worker, so it is the only binary.
COPY ./node /opt/ceremonyclient/node
WORKDIR /opt/ceremonyclient/node

# build.sh compiles the Rust `quil-node` crate in release mode. The AVX-512
# suffix on the output directory is driven by the AVX512 env var; with it set
# the binary lands at node/build/amd64_avx512_linux/node.
ENV AVX512=1
RUN ./build.sh && cp build/*/node /usr/bin/node

FROM build-avx512 AS build-qclient-avx512
ARG TARGETOS
ARG TARGETARCH
# Build and install the Rust `qclient` (crates/quil-client). qclient needs no
# AVX-512 tuning (that targets the node's VDF/crypto), so this is a plain
# release build. The `cp` runs in the same RUN as the build because target/ is
# a cache mount.
WORKDIR /opt/ceremonyclient
# quil-client depends on quil-execution, which embeds the genesis seniority
# compat data from node/execution/... (retro JSONs via include_bytes! +
# mainnet_244200_seniority.json via build.rs). build-avx512 excludes node/, so
# bring in just that data dir here.
COPY ./node/execution/intrinsics/global/compat /opt/ceremonyclient/node/execution/intrinsics/global/compat
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=cargo-target-qclient,target=/opt/ceremonyclient/target \
    cargo build --release -p quil-client --bin qclient && \
    cp target/release/qclient /usr/bin/qclient

# Allows exporting single binary
FROM scratch AS node
COPY --from=build-node-avx512 /usr/bin/node /node
ENTRYPOINT [ "/node" ]

# Allows exporting single binary
FROM scratch AS qclient-unix
COPY --from=build-qclient-avx512 /usr/bin/qclient /qclient
ENTRYPOINT [ "/qclient" ]

FROM qclient-unix AS qclient-linux
FROM qclient-unix AS qclient-darwin
FROM qclient-${TARGETOS} AS qclient

FROM ubuntu:24.04 AS final

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libgmp10 \
    libmpfr6 \
    && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION
ARG GIT_REPO
ARG GIT_BRANCH
ARG GIT_COMMIT

LABEL org.opencontainers.image.title="Quilibrium Network Node"
LABEL org.opencontainers.image.description="Quilibrium is a decentralized alternative to platform as a service providers."
LABEL org.opencontainers.image.version=$NODE_VERSION
LABEL org.opencontainers.image.vendor=Quilibrium
LABEL org.opencontainers.image.url=https://quilibrium.com/
LABEL org.opencontainers.image.documentation=https://quilibrium.com/docs
LABEL org.opencontainers.image.source=$GIT_REPO
LABEL org.opencontainers.image.ref.name=$GIT_BRANCH
LABEL org.opencontainers.image.revision=$GIT_COMMIT

COPY --from=build-node-avx512 /usr/bin/node /usr/local/bin
COPY --from=build-qclient-avx512 /usr/bin/qclient /usr/local/bin

WORKDIR /root

ENTRYPOINT ["node"]
