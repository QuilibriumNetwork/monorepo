# syntax=docker.io/docker/dockerfile:1.7-labs
# Build on ubuntu:22.04 (glibc 2.35) so the dynamically-linked binaries
# run on Ubuntu 22.04 hosts as well as newer releases — glibc symbol
# versions are stamped from the build environment, and binaries linked
# on 24.04 (glibc 2.39) refuse to load on 22.04. Runtime image stages
# below stay on 24.04; the binary is forward-compatible.
#
# Build from the repository root, e.g.:
#   docker build -f docker/Dockerfile.source --target=node --output node/build/amd64_linux .
FROM --platform=${TARGETPLATFORM} ubuntu:22.04 AS base

# Common environment variables
ENV PATH="${PATH}:/root/.cargo/bin/"
ARG TARGETOS
ARG TARGETARCH

# Install basics. Note: no apt libflint-dev (22.04 ships FLINT 2.8; the
# flint-builder stage provides 3.0 under /usr/local) and no apt
# protobuf-compiler (22.04 ships protoc 3.12, which predates the proto3
# `optional` support prost-build needs — upstream protoc installed below).
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    cmake \
    libgmp-dev \
    libmpfr-dev \
    libmpfr6 \
    wget \
    m4 \
    pkg-config \
    gcc \
    g++ \
    make \
    autoconf \
    automake \
    libtool \
    libssl-dev \
    clang \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG PROTOC_VERSION=25.1
RUN ARCH=$(dpkg --print-architecture) && \
    case ${ARCH} in \
    amd64) PROTOC_ARCH=x86_64 ;; \
    arm64) PROTOC_ARCH=aarch_64 ;; \
    *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/protoc.zip \
        https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip && \
    unzip -o /tmp/protoc.zip -d /usr/local bin/protoc 'include/*' && \
    rm /tmp/protoc.zip

# -----------------------------------------------------------------------------
# Stage: gmp-builder
# Purpose: Build GMP from source as a static, PIC archive. FLINT's static
# code references internal `__gmpn_*` symbols that aren't guaranteed to be
# exported by every distro's libgmp.so — users running the binary on a
# host whose libgmp differs from our build image hit runtime
# `symbol lookup error: undefined symbol: __gmpn_modexact_1_odd` failures.
# Bundling GMP into the static link removes that dependency entirely.
# -----------------------------------------------------------------------------
FROM base AS gmp-builder

ARG GMP_VERSION=6.3.0
RUN wget https://gmplib.org/download/gmp/gmp-${GMP_VERSION}.tar.xz && \
    tar -xf gmp-${GMP_VERSION}.tar.xz && \
    cd gmp-${GMP_VERSION} && \
    ./configure \
        --prefix=/usr/local \
        --enable-static \
        --disable-shared \
        --with-pic \
        CFLAGS="-O3" && \
    make -j$(nproc) && \
    make install

# -----------------------------------------------------------------------------
# Stage: flint-builder
# Purpose: Build FLINT library (slowest component). Inherits the static GMP
# from gmp-builder so FLINT's static archive links against the same GMP we
# bundle into the final binary.
# -----------------------------------------------------------------------------
FROM gmp-builder AS flint-builder

RUN git clone --branch flint-3.0 --depth 1 https://github.com/flintlib/flint.git && \
    cd flint && \
    ./bootstrap.sh && \
    ./configure \
    --prefix=/usr/local \
    --with-gmp=/usr/local \
    --with-mpfr=/usr/local \
    --enable-static \
    --disable-shared \
    CFLAGS="-O3 -fPIC" && \
    make -j$(nproc) && \
    make install

# -----------------------------------------------------------------------------
# Stage: emp-builder
# Purpose: Build EMP-toolkit libraries
# -----------------------------------------------------------------------------
FROM base AS emp-builder

WORKDIR /opt/ceremonyclient
# Copy the necessary script and source directories
COPY install-emp.sh .
COPY emp-tool emp-tool
COPY emp-ot emp-ot

RUN bash install-emp.sh

# Fix emp-tool to be static and install
RUN cd emp-tool && sed -i 's/add_library(${NAME} SHARED ${sources})/add_library(${NAME} STATIC ${sources})/g' CMakeLists.txt && mkdir build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && cd .. && make -j$(nproc) && make install

# Install emp-ot
RUN cd emp-ot && mkdir build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && cd .. && make -j$(nproc) && make install

# -----------------------------------------------------------------------------
# Stage: rust-base
# Purpose: Install the Rust toolchain
# -----------------------------------------------------------------------------
FROM base AS rust-base

COPY docker/rustup-init.sh /opt/rustup-init.sh
RUN /opt/rustup-init.sh -y --profile minimal

# -----------------------------------------------------------------------------
# Stage: libs-context
# Purpose: The static native libraries the Rust crates link against
# -----------------------------------------------------------------------------
FROM base AS libs-context
# flint-builder inherits from gmp-builder, so copying its /usr/local brings
# both libflint.a and libgmp.a along in one shot.
COPY --from=flint-builder /usr/local /usr/local
COPY --from=emp-builder /usr/local /usr/local

# -----------------------------------------------------------------------------
# Stage: common-context
# Purpose: Native libraries, the Rust toolchain and the workspace crates
# -----------------------------------------------------------------------------
FROM libs-context AS common-context

COPY --from=rust-base /root/.cargo /root/.cargo
COPY --from=rust-base /root/.rustup /root/.rustup
ENV PATH="${PATH}:/root/.cargo/bin/"

ENV QUILIBRIUM_SIGNATURE_CHECK=true

WORKDIR /opt/ceremonyclient

# Rust workspace files (rarely change)
COPY Cargo.toml Cargo.lock ./

# Rust crate sources (needed by the cargo builds in the build-* stages below).
# BuildKit normalizes mtimes on COPY, so cargo's mtime-based fingerprint
# check inside the target/ cache mount may over-rebuild. The cache mount
# still provides value for the registry/git caches and for cargo's
# content-derived intermediate artifacts.
COPY crates crates

# -----------------------------------------------------------------------------
# Stage: build-context
# Purpose: Aggregate source tree and static libraries for the Rust builds
# -----------------------------------------------------------------------------
FROM common-context AS build-context

# Copy full source tree for the Rust builds. node/ is brought in by the stages
# that need it, so changes there only bust those stages.
COPY --exclude=node . .

# -----------------------------------------------------------------------------
# Stage: test-context
# The build environment (full source + native deps) plus node/, whose compat
# data several crates embed. `task test_rust_amd64_linux` runs the workspace
# tests in it.
# -----------------------------------------------------------------------------
FROM build-context AS test-context
COPY ./node /opt/ceremonyclient/node

# -----------------------------------------------------------------------------
# Stage: build-node
# Builds the Rust node (crates/quil-node) and its confidential token proof
# verifier worker (quil-amount-proof-worker), which the node runs as a child
# process resolved beside its own binary.
# -----------------------------------------------------------------------------
FROM build-context AS build-node
COPY ./node /opt/ceremonyclient/node
WORKDIR /opt/ceremonyclient/node
# build.sh compiles the Rust `quil-node` crate and the proof worker in release
# mode and installs them at node/build/<platform>/. The wildcard copy lets this
# same Dockerfile serve amd64/arm64 Linux builds without a platform switch.
# build.sh writes to node/build/<platform>/, outside the cache-mounted target/,
# so the cp after the && finds the binaries on the real filesystem.
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=cargo-target-node,target=/opt/ceremonyclient/target \
    ./build.sh && cp build/*/node /usr/bin/node && \
    cp build/*/quil-amount-proof-worker /usr/bin/quil-amount-proof-worker

# -----------------------------------------------------------------------------
# Stage: build-qclient
# Builds the Rust `qclient` (crates/quil-client). Uses the same native-lib
# toolchain and cargo caches as build-node; a dedicated target cache avoids
# cargo fingerprint thrash against build-node's different `-p` set. The `cp`
# runs inside the same RUN as the build because target/ is a cache mount.
# -----------------------------------------------------------------------------
FROM build-context AS build-qclient
ARG TARGETOS
ARG TARGETARCH
WORKDIR /opt/ceremonyclient
# quil-client depends on quil-execution, which embeds the genesis seniority
# compat data from node/execution/... (retro JSONs via include_bytes! +
# mainnet_244200_seniority.json via build.rs). build-context excludes node/,
# so bring in just that data dir here.
COPY ./node/execution/intrinsics/global/compat /opt/ceremonyclient/node/execution/intrinsics/global/compat
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=cargo-target-qclient,target=/opt/ceremonyclient/target \
    cargo build --release -p quil-client --bin qclient && \
    cp target/release/qclient /usr/bin/qclient

# -----------------------------------------------------------------------------
# Stage: node-only
# -----------------------------------------------------------------------------
FROM ubuntu:24.04 AS node-only
ARG NODE_VERSION
ARG GIT_REPO
ARG GIT_BRANCH
ARG GIT_COMMIT

LABEL org.opencontainers.image.title="Quilibrium Network Node"
LABEL org.opencontainers.image.description="Quilibrium is a decentralized alternative to platform as a service providers."
LABEL org.opencontainers.image.version=$NODE_VERSION
LABEL org.opencontainers.image.vendor=Quilibrium
LABEL org.opencontainers.image.url=https://quilibrium.com/
LABEL org.opencontainers.image.documentation=https://quilibrium.com/docs
LABEL org.opencontainers.image.source=$GIT_REPO
LABEL org.opencontainers.image.ref.name=$GIT_BRANCH
LABEL org.opencontainers.image.revision=$GIT_COMMIT

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libgmp10 \
    libmpfr6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build-node /usr/bin/node /usr/local/bin/node
# Token proof verifier worker, resolved by the node as its sibling file.
COPY --from=build-node /usr/bin/quil-amount-proof-worker /usr/local/bin/quil-amount-proof-worker
WORKDIR /root
ENTRYPOINT ["node"]

# -----------------------------------------------------------------------------
# Stage: exports (Scratch)
# -----------------------------------------------------------------------------
FROM scratch AS node
COPY --from=build-node /usr/bin/node /node
COPY --from=build-node /usr/bin/quil-amount-proof-worker /quil-amount-proof-worker
ENTRYPOINT [ "/node" ]

FROM scratch AS qclient-unix
COPY --from=build-qclient /usr/bin/qclient /qclient
ENTRYPOINT [ "/qclient" ]

FROM qclient-unix AS qclient-linux
FROM qclient-unix AS qclient-darwin
FROM qclient-${TARGETOS} AS qclient

# -----------------------------------------------------------------------------
# Stage: final (Default combined image)
# -----------------------------------------------------------------------------
FROM ubuntu:24.04 AS final

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libgmp10 \
    libmpfr6 \
    && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION
ARG GIT_REPO
ARG GIT_BRANCH
ARG GIT_COMMIT

LABEL org.opencontainers.image.title="Quilibrium Network Node"
LABEL org.opencontainers.image.description="Quilibrium is a decentralized alternative to platform as a service providers."
LABEL org.opencontainers.image.version=$NODE_VERSION
LABEL org.opencontainers.image.vendor=Quilibrium
LABEL org.opencontainers.image.url=https://quilibrium.com/
LABEL org.opencontainers.image.documentation=https://quilibrium.com/docs
LABEL org.opencontainers.image.source=$GIT_REPO
LABEL org.opencontainers.image.ref.name=$GIT_BRANCH
LABEL org.opencontainers.image.revision=$GIT_COMMIT

COPY --from=build-node /usr/bin/node /usr/local/bin
COPY --from=build-node /usr/bin/quil-amount-proof-worker /usr/local/bin
COPY --from=build-qclient /usr/bin/qclient /usr/local/bin

WORKDIR /root
ENTRYPOINT ["node"]
